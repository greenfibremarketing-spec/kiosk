# Server-only. Never expose these in the browser.
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
# LLM key for LangChain (provider of your choice)
LLM_API_KEY=

# Deepgram Speech-to-Text API Key
DEEPGRAM_API_KEY=

# ==============================================================================
# AI BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Active environment selector: "local" | "testing" | "production"
NEXT_PUBLIC_ENV=local

# Local / Testing Endpoints (Uvicorn running on port 5007)
NEXT_PUBLIC_LOCAL_BACKEND_URL=http://localhost:5007
NEXT_PUBLIC_LOCAL_API_URL=http://localhost:5007/chat
NEXT_PUBLIC_LOCAL_WS_URL=ws://localhost:5007/ws/chat

# Production Endpoints
NEXT_PUBLIC_PROD_BACKEND_URL=https://kioskai.greenfibre.org
NEXT_PUBLIC_PROD_API_URL=https://kioskai.greenfibre.org/chat
NEXT_PUBLIC_PROD_WS_URL=wss://kioskai.greenfibre.org/ws/chat

# Optional Manual Overrides (Leave commented out to follow NEXT_PUBLIC_ENV)
# NEXT_PUBLIC_BACKEND_URL=http://localhost:5007
# NEXT_PUBLIC_API_URL=http://localhost:5007/chat
# NEXT_PUBLIC_WS_URL=ws://localhost:5007/ws/chat

# Optional Kiosk Configuration
NEXT_PUBLIC_KIOSK_NAME="GreenFibre Smart Kiosk"

# Kiosk Intro Video API Base (default: https://kioskai.greenfibre.org, local testing: http://localhost:5000)
NEXT_PUBLIC_INTRO_API_BASE=https://kioskai.greenfibre.org
