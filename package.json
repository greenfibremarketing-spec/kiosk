{
  "name": "greenfibre-kiosk",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "build": "next build",
    "electron": "electron .",
    "start": "electron .",
    "dev": "next build && electron . --dev",
    "dist": "npm run build && electron-builder --win",
    "mock:intro": "node scripts/mock-intro-api.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.5",
    "@fontsource/nunito": "5.2.5",
    "@mediapipe/tasks-vision": "1.0.1",
    "@vladmandic/human": "^3.3.6",
    "electron-log": "5.4.4",
    "lucide-react": "^1.57.0",
    "next": "16.3.8",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.greenfibre.kiosk",
    "productName": "GreenFibre Kiosk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "!out/test-videos/**",
      "electron/**",
      "server/**",
      "package.json",
      "config.json"
    ],
    "asarUnpack": [
      "server/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true
    }
  }
}
